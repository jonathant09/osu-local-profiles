{
  "name": "osu-local-profiles",
  "version": "1.34.0",
  "private": true,
  "description": "Track an alternative osu! playstyle as its own profile, kept locally on your machine.",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "dotnet run --project dotnet/App -c Release",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "check:port": "dotnet test dotnet/OsuLocalProfiles.slnx --nologo",
    "pp:parity": "node scripts/pp-parity.mjs",
    "parity:api": "node scripts/api-parity.mjs",
    "build:launcher": "node scripts/build-launcher.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "ui": "node scripts/ui-check.mjs",
    "rank:refresh": "node scripts/build-rank-table.mjs all --latest",
    "build:flags": "node scripts/build-flags.mjs",
    "build:mods": "node scripts/build-mod-table.mjs",
    "build:osu-web": "node scripts/build-osu-web-art.mjs",
    "build:feed-icons": "node scripts/build-feed-icons.mjs",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "lzma-js-simple-v2": "^1.2.3",
    "typescript": "^5.7.0"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathant09/osu-local-profiles.git"
  }
}
