<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>osu-pp</AssemblyName>
    <RootNamespace>OsuLocalProfiles.PpCalculator</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <!--
    No trimming settings here on purpose. The slim helper is trimmed by scripts/build-pp-helper.mjs
    (SLIM_PUBLISH_ARGS), which builds the full one beside it and ships the slim one only when
    scripts/pp-parity.mjs finds every answer identical (roadmap 5.60). A setting here would trim
    every publish, checked or not.
  -->
  <ItemGroup>
    <PackageReference Include="ppy.osu.Game" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Osu" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Taiko" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Catch" Version="2026.916.0" />
    <PackageReference Include="ppy.osu.Game.Rulesets.Mania" Version="2026.916.0" />
  </ItemGroup>
  <!--
    AutoMapper 13.0.1 comes from ppy.osu.Game, which uses it only to detach Realm objects. The
    helper opens no Realm, so AutoMapper never runs here, and the advisory needs an attacker's
    object graph mapped through it. Its fix (15.1.1) is not a drop-in: 15 changed licence and
    API, and osu.Game is built against 13. Drop this when osu.Game moves past it.
  -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>
</Project>
