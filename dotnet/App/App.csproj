<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>osu-local-profiles-app</AssemblyName>
    <RootNamespace>OsuLocalProfiles</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kestrel. HttpListener goes through http.sys on Windows, which needs admin rights to answer
         anything but "localhost" as the host (docs/csharp-port.md, Decisions). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- osu!'s own calculators, in-process: the helper's code itself, so the osu! package versions
         stay in tools/PpCalculator/PpCalculator.csproj alone, where the weekly job updates them
         (docs/automated-maintenance.md). -->
    <ProjectReference Include="..\..\tools\PpCalculator\PpCalculator.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The schema, and the tables built from osu!'s data (scripts/build-medal-table.mjs,
         scripts/build-rank-table.mjs). -->
    <EmbeddedResource Include="Db\schema.sql" LogicalName="schema.sql" />
    <EmbeddedResource Include="Calc\medal-definitions.json" LogicalName="medal-definitions.json" />
    <EmbeddedResource Include="Calc\rank-tables\*.json" LogicalName="rank-tables/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="App.Tests" />
  </ItemGroup>
</Project>
